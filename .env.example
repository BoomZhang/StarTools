# ===== Docker Compose 使用 =====
# 复制为 .env 后按需修改：cp .env.example .env

# 对外访问端口（http://localhost:8080/startools/）
APP_PORT=8080

# PostgreSQL
POSTGRES_USER=startools
POSTGRES_PASSWORD=startools
POSTGRES_DB=startools
# 本机开发时映射到 127.0.0.1 的端口
POSTGRES_PORT=5432

# Redis
# 本机开发时映射到 127.0.0.1 的端口
REDIS_PORT=6379

# 允许跨域的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# 管理台单账号（部署前必须修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=startools-admin
JWT_SECRET=startools-dev-jwt-secret-change-before-deploying
# 非 localhost 的 HTTPS 部署应设为 true
COOKIE_SECURE=false

# 镜像构建源（国内网络环境使用；海外部署可改为 deb.debian.org / pypi.org）
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 磁盘保护阈值：PRD 正式部署值为 80。
# 本机开发磁盘较满时可临时调高（当前示例为 95）；对外部署前请改回 80。
DISK_STOP_PERCENT=95
