APP_ENV=development
# 本机开发：数据库 / Redis 由 docker compose 的 db、redis 服务提供
DATABASE_URL=postgresql+asyncpg://startools:startools@127.0.0.1:5432/startools
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 管理台账号（部署时务必修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=startools-admin
JWT_SECRET=startools-dev-jwt-secret-change-before-deploying

# 本机文件存储
STORAGE_DIR=storage

# 语音识别模型（本地开发；Docker 内为 /app/models）
MODELS_DIR=models
WHISPER_MODEL_DIR=models/whisper
WHISPER_MODEL_SIZE=base
HF_ENDPOINT=https://hf-mirror.com

# 磁盘保护阈值：达到该占用率后停止接收服务端任务。
# PRD 的正式部署值为 80；本机开发磁盘较满时可临时调高（例如 95）。
DISK_STOP_PERCENT=95
